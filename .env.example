# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ispcms
DB_USER=ispcms
DB_PASSWORD=secret
DB_SSL_MODE=disable

# JWT
JWT_SECRET=change-me-super-secret-key-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server
SERVER_PORT=8080
SERVER_ENV=development
CORS_ORIGINS=http://localhost:5869

# Security
BCRYPT_COST=12
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=30

# Initial Super Admin
SUPER_ADMIN_EMAIL=admin@ispcms.local
SUPER_ADMIN_PASSWORD=Admin@1234
SUPER_ADMIN_USERNAME=superadmin

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
